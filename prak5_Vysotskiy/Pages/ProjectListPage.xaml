<Page x:Class="prak5_Vysotskiy.Pages.ProjectListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Список проектов">
    <DockPanel Margin="15">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Список проектов" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
            <WrapPanel Margin="0,0,0,10">
                <Button Content="Добавить" Click="Add_Click" Padding="12,6" Margin="0,0,6,0"/>
                <Button Content="Изменить" Click="Edit_Click" Padding="12,6" Margin="0,0,6,0"/>
                <Button Content="Удалить" Click="Delete_Click" Padding="12,6" Margin="0,0,6,0"/>
                <Button Content="Сохранить JSON" Click="Save_Click" Padding="12,6" Margin="0,0,6,0"/>
                <Button Content="Загрузить JSON" Click="Load_Click" Padding="12,6"/>
            </WrapPanel>
        </StackPanel>
        <ListView x:Name="ProjectsList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Name}" Width="200"/>
                    <GridViewColumn Header="Руководитель" DisplayMemberBinding="{Binding Manager}" Width="170"/>
                    <GridViewColumn Header="Дата начала" DisplayMemberBinding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                    <GridViewColumn Header="Выполнение, %" DisplayMemberBinding="{Binding ProjectProgress, StringFormat={}{0:F1}}" Width="130"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Page>
