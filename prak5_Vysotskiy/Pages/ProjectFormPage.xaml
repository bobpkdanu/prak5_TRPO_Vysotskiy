<Page x:Class="prak5_Vysotskiy.Pages.ProjectFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Редактирование проекта">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Данные проекта" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBlock Text="Название проекта"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
            <TextBlock Text="Руководитель"/>
            <TextBox Text="{Binding Manager, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
            <TextBlock Text="Дата начала"/>
            <DatePicker SelectedDate="{Binding StartDate}" Margin="0,4,0,10"/>
            <TextBlock Text="{Binding ProjectProgress, StringFormat=Среднее выполнение: {0:F1}%}"
                       FontSize="16" Margin="0,0,0,12"/>
            <TextBlock Text="Задачи проекта" FontSize="18" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,6,0,8">
                <Button Content="Добавить задачу" Click="AddTask_Click" Padding="10,5" Margin="0,0,6,0"/>
                <Button Content="Изменить задачу" Click="EditTask_Click" Padding="10,5" Margin="6,0,0,0"/>
                <Button Content="Удалить задачу" Click="DeleteTask_Click" Padding="10,5"/>
            </WrapPanel>
            <ListView x:Name="TasksList" ItemsSource="{Binding Tasks}" Height="220" Margin="0,0,0,12">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <TextBlock Text="{Binding Title}"
                               FontWeight="Bold"/>
                            <TextBlock Text="{Binding Executor,
                                      StringFormat=Исполнитель: {0}}"/>
                            <TextBlock Text="{Binding Progress,
                                      StringFormat=Выполнение: {0}%}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <WrapPanel>
                <Button Content="Сохранить" Click="Save_Click" Padding="12,6" Margin="0,0,6,0"/>
                <Button Content="Назад" Click="Back_Click" Padding="12,6"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
