<Page x:Class="prak5_Vysotskiy.Pages.TaskFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задача">

    <StackPanel Margin="20">
        <TextBlock Text="Название задачи"/>
        <TextBox x:Name="TitleBox" Margin="0,5,0,10"/>

        <TextBlock Text="Исполнитель"/>
        <TextBox x:Name="ExecutorBox" Margin="0,5,0,10"/>

        <TextBlock Text="Выполнение (0–100)"/>
        <TextBox x:Name="ProgressBox" Text="0" Margin="0,5,0,10"/>

        <StackPanel Orientation="Horizontal">
            <Button Content="Сохранить" Click="Save_Click" Padding="10,5" Margin="0,0,5,0"/>
            <Button Content="Назад" Click="Back_Click" Padding="10,5"/>
        </StackPanel>
    </StackPanel>
</Page>
